{
  "name": "@licolite/lico-arc",
  "version": "0.0.1",
  "description": "Lico-Arc is the private LicoLite official client repository.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/LicoLite/Lico-Arc.git"
  },
  "packageManager": "npm@11.13.0",
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "repo:client-boundary": "node tools/verify-client-boundary.mjs",
    "client:format:check": "cd apps/desktop && dart format --output=none --set-exit-if-changed lib test",
    "client:native:fmt:check": "cargo fmt --all -- --check",
    "client:native:clippy": "cargo clippy --workspace --all-targets -- -D warnings -A clippy::style -A clippy::complexity -A clippy::perf",
    "client:deps:audit": "npm audit --omit=dev && cargo audit --file Cargo.lock --deny warnings --ignore RUSTSEC-2026-0124 --ignore RUSTSEC-2026-0173",
    "client:get": "cd apps/desktop && flutter pub get",
    "client:analyze": "cd apps/desktop && flutter analyze",
    "client:test": "cd apps/desktop && flutter test",
    "client:native:test": "cargo test --manifest-path crates/lico-client-native/Cargo.toml",
    "client:native:smoke": "node tests/smoke/native-client-smoke.mjs",
    "client:contracts:test": "node tests/contract/client/contracts-client.test.mjs",
    "client:verify:architecture": "node apps/desktop/scripts/verify-client-architecture.mjs",
    "client:verify:layouts": "node apps/desktop/scripts/verify-layout-boundaries.mjs",
    "client:verify:plan": "node apps/desktop/scripts/verify-client-plan.mjs",
    "client:verify:targets": "node apps/desktop/scripts/verify-client-architecture.mjs",
    "client:verify:config-writes": "node apps/desktop/scripts/verify-client-architecture.mjs",
    "client:verify:state-store": "node apps/desktop/scripts/verify-client-architecture.mjs",
    "client:verify:pairing-skill-cli": "node apps/desktop/scripts/verify-client-architecture.mjs",
    "client:verify:skill-installer": "node apps/desktop/scripts/verify-client-architecture.mjs",
    "client:verify:mcp-plugins": "node apps/desktop/scripts/verify-client-architecture.mjs",
    "client:verify:thin-forwarding": "node apps/desktop/scripts/verify-client-architecture.mjs",
    "client:verify:secure-mesh": "cargo test --manifest-path crates/lico-client-native/Cargo.toml secure_mesh",
    "client:verify:agent-usage": "node apps/desktop/scripts/verify-client-agent-usage.mjs",
    "client:verify:update-release": "node tests/verify-client-update-release-channel.mjs",
    "client:verify:windows-file-security": "node tests/verify-windows-file-security-boundary.mjs",
    "client:runtime:package": "node tools/client-runtime/build-client-runtime-package.mjs",
    "client:run:macos": "node apps/desktop/scripts/run-macos-client.mjs",
    "client:package:plan": "node apps/desktop/scripts/package-client.mjs --dry-run",
    "client:icon:macos": "node apps/desktop/scripts/generate-macos-app-icon.mjs",
    "client:build:macos": "node apps/desktop/scripts/package-client.mjs --platform macos --mode release",
    "client:build:linux": "node apps/desktop/scripts/build-linux-bundle.mjs --mode release",
    "client:build:windows": "node apps/desktop/scripts/package-client.mjs --platform windows --mode release",
    "client:build:android": "node apps/desktop/scripts/build-android-apk.mjs --release",
    "client:install:macos": "node apps/desktop/scripts/package-client.mjs --platform macos --mode release --install",
    "client:linux:smoke": "node apps/desktop/scripts/smoke-linux-bundle.mjs",
    "client:linux:gui-smoke": "node apps/desktop/scripts/gui-smoke-linux-bundle.mjs",
    "client:ubuntu:verify": "node apps/desktop/scripts/verify-ubuntu-client.mjs",
    "client:verify:windows-bundle": "node apps/desktop/scripts/verify-windows-client-bundle.mjs",
    "client:verify": "node tools/run-client-verify.mjs"
  }
}
