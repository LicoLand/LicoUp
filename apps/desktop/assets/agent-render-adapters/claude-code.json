{
  "schemaVersion": 1,
  "id": "claude-code",
  "displayName": "Claude Code",
  "match": {
    "agentIds": ["claude-code", "claude"],
    "sourceClients": ["claude-code"],
    "adapterIds": ["claude-code"]
  },
  "layout": {
    "assistant": "document",
    "assistantMaxWidth": 760,
    "assistantHorizontalInset": 32,
    "assistantVerticalPadding": 18,
    "showAssistantRoleLabel": false,
    "showUserRoleLabel": false
  },
  "userBubble": {
    "maxWidth": 620,
    "radius": 24,
    "paddingX": 18,
    "paddingY": 13,
    "tone": "neutral"
  },
  "markdown": {
    "bodyFontSize": 15,
    "bodyLineHeight": 1.58,
    "blockSpacing": 16,
    "heading1FontSize": 21,
    "heading2FontSize": 18,
    "heading3FontSize": 16,
    "headingWeight": 800,
    "codeFontSize": 13,
    "codeLineHeight": 1.48,
    "codeRadius": 16,
    "codePadding": 16,
    "showCodeLanguage": true,
    "quoteRadius": 14,
    "quotePaddingX": 14,
    "quotePaddingY": 12,
    "listMarkerWidth": 26,
    "orderedListMarkerWidth": 36,
    "listItemSpacing": 8,
    "unorderedMarker": "\u2022"
  },
  "tones": {
    "code": "raised",
    "quote": "subtle"
  }
}
