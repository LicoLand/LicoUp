{
  "schemaVersion": 1,
  "id": "codex",
  "displayName": "Codex",
  "match": {
    "agentIds": ["codex"],
    "sourceClients": ["codex"],
    "adapterIds": ["codex"]
  },
  "layout": {
    "assistant": "document",
    "assistantMaxWidth": 880,
    "assistantHorizontalInset": 30,
    "assistantVerticalPadding": 18,
    "showAssistantRoleLabel": false,
    "showUserRoleLabel": false
  },
  "userBubble": {
    "maxWidth": 680,
    "radius": 22,
    "paddingX": 18,
    "paddingY": 12,
    "tone": "neutral"
  },
  "markdown": {
    "bodyFontSize": 15,
    "bodyLineHeight": 1.55,
    "blockSpacing": 15,
    "heading1FontSize": 20,
    "heading2FontSize": 18,
    "heading3FontSize": 16,
    "headingWeight": 800,
    "codeFontSize": 13,
    "codeLineHeight": 1.45,
    "codeRadius": 12,
    "codePadding": 14,
    "showCodeLanguage": true,
    "quoteRadius": 10,
    "quotePaddingX": 14,
    "quotePaddingY": 10,
    "listMarkerWidth": 24,
    "orderedListMarkerWidth": 34,
    "listItemSpacing": 7,
    "unorderedMarker": "\u2022"
  },
  "tones": {
    "code": "surface",
    "quote": "subtle"
  }
}
