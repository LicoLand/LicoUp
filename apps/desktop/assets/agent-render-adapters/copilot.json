{
  "schemaVersion": 1,
  "id": "copilot",
  "displayName": "GitHub Copilot",
  "match": {
    "agentIds": ["copilot", "github-copilot"],
    "sourceClients": ["copilot"],
    "adapterIds": ["copilot"]
  },
  "layout": {
    "assistant": "document",
    "assistantMaxWidth": 820,
    "assistantHorizontalInset": 28,
    "assistantVerticalPadding": 16,
    "showAssistantRoleLabel": false,
    "showUserRoleLabel": false
  },
  "userBubble": {
    "maxWidth": 650,
    "radius": 20,
    "paddingX": 18,
    "paddingY": 12,
    "tone": "neutral"
  },
  "markdown": {
    "bodyFontSize": 15,
    "bodyLineHeight": 1.53,
    "blockSpacing": 14,
    "heading1FontSize": 20,
    "heading2FontSize": 17,
    "heading3FontSize": 16,
    "headingWeight": 800,
    "codeFontSize": 13,
    "codeLineHeight": 1.44,
    "codeRadius": 10,
    "codePadding": 14,
    "showCodeLanguage": true,
    "quoteRadius": 10,
    "quotePaddingX": 14,
    "quotePaddingY": 10,
    "listMarkerWidth": 24,
    "orderedListMarkerWidth": 34,
    "listItemSpacing": 7,
    "unorderedMarker": "\u2022"
  },
  "tones": {
    "code": "surface",
    "quote": "subtle"
  }
}
