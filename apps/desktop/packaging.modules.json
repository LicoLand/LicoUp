{
  "schemaVersion": "v0.0.1:client-desktop:packaging-modules-1",
  "description": "LicoUp desktop client packaging. Modules are organized by runtime function.",
  "packageProfile": "licoup",
  "bundle": {
    "moduleResourceDirectory": "modules",
    "manifestPath": "package-metadata/licoup/packaging-modules.json"
  },
  "modules": {
    "portable-data": {
      "label": "LicoUp client local settings, agent discovery cache, encrypted pairing state, skills, usage, activity, and conversation snapshots",
      "category": "storage",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "portable-data",
      "portableDirectories": [
        "licoup",
        "licoup/settings",
        "licoup/targets",
        "licoup/pairings",
        "licoup/skills",
        "licoup/pins",
        "licoup/mobile-relay",
        "licoup/activity",
        "licoup/snapshots"
      ]
    },
    "target-adapters": {
      "label": "Target adapters for Antigravity, Claude Code, Codex, Cursor, GitHub Copilot, Hermes Agent, Kilo Code, Kimi Code, OpenClaw, OpenCode, and Pi Agent",
      "category": "agents",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "portable-data"
      ],
      "targetAdapters": [
        "openclaw",
        "claude-code",
        "codex",
        "antigravity",
        "opencode",
        "copilot",
        "kilo-code",
        "cursor",
        "hermes",
        "kimi-code",
        "pi"
      ]
    },
    "local-task-queue": {
      "label": "Bounded Rust FIFO queue for lightweight local client work",
      "category": "runtime",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar"
      ]
    },
    "protocol-adapters": {
      "label": "Service-neutral ACP conversation and MCP request/response adapters",
      "category": "protocols",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "target-adapters"
      ]
    },
    "skill-hub": {
      "label": "Passive Skill Hub boundary",
      "category": "skill-hub",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "portable-data"
      ]
    },
    "mobile-relay": {
      "label": "Mobile pairing and command relay control plane",
      "category": "mobile-relay",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data",
        "target-adapters"
      ]
    },
    "activity-snapshots": {
      "label": "Activity log and independent snapshot store",
      "category": "activity",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data"
      ]
    },
    "settings": {
      "label": "LicoUp client settings store",
      "category": "settings",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data"
      ]
    },
    "desktop-app": {
      "label": "Flutter future desktop frontend",
      "category": "core",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "flutter-app"
    },
    "native-sidecar": {
      "label": "Rust LicoUp client CLI sidecar",
      "category": "core",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "sidecar-binary",
      "cargoBin": "licoup-cli"
    },
    "subagents-mcp": {
      "label": "LicoUp local subagent MCP",
      "category": "agents",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "sidecar-binary",
      "cargoBin": "lico-subagent-mcp",
      "requires": [
        "native-sidecar"
      ]
    },
    "llm-gateway-sidecar": {
      "label": "LicoUp loopback model protocol and provider routing gateway",
      "category": "agents",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "sidecar-binary",
      "cargoBin": "lico-llm-gateway",
      "requires": [
        "native-sidecar"
      ]
    },
    "codex-plugin": {
      "label": "LicoUp Codex Plugin companion runtime",
      "category": "agents",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "module-resources",
      "embeddedCargoBin": "lico-subagent-mcp",
      "embeddedCargoTarget": "plugins/lico-up-codex/bin/lico-subagent-mcp",
      "requires": [
        "subagents-mcp"
      ]
    }
  },
  "deferredCapabilities": {}
}
