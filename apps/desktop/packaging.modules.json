{
  "schemaVersion": "v0.0.1:client-desktop:packaging-modules-1",
  "description": "Lico Arc desktop client packaging. Modules are organized by runtime function.",
  "packageProfile": "lico-client",
  "bundle": {
    "moduleResourceDirectory": "modules",
    "manifestPath": "package-metadata/lico-client/packaging-modules.json"
  },
  "modules": {
    "portable-data": {
      "label": "LicoArc client local settings, agent discovery cache, encrypted pairing state, skills, usage, activity, and conversation snapshots",
      "category": "storage",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "portable-data",
      "portableDirectories": [
        "lico-client",
        "lico-client/settings",
        "lico-client/targets",
        "lico-client/pairings",
        "lico-client/skills",
        "lico-client/pins",
        "lico-client/mobile-relay",
        "lico-client/activity",
        "lico-client/snapshots"
      ]
    },
    "target-adapters": {
      "label": "Target adapters for Antigravity, Claude Code, Codex, Cursor, GitHub Copilot, Hermes Agent, Kilo Code, Kimi Code, OpenClaw, OpenCode, and Pi Agent",
      "category": "agents",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "portable-data"
      ],
      "targetAdapters": [
        "openclaw",
        "claude-code",
        "codex",
        "antigravity",
        "opencode",
        "copilot",
        "kilo-code",
        "cursor",
        "hermes",
        "kimi-code",
        "pi"
      ]
    },
    "local-task-queue": {
      "label": "Bounded Rust FIFO queue for lightweight local client work",
      "category": "runtime",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar"
      ]
    },
    "protocol-adapters": {
      "label": "Service-neutral ACP conversation and MCP request/response adapters",
      "category": "protocols",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "target-adapters"
      ]
    },
    "skill-hub": {
      "label": "Passive Skill Hub boundary",
      "category": "skill-hub",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "portable-data"
      ]
    },
    "mobile-relay": {
      "label": "Mobile pairing and command relay control plane",
      "category": "mobile-relay",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data",
        "target-adapters"
      ]
    },
    "activity-snapshots": {
      "label": "Activity log and independent snapshot store",
      "category": "activity",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data"
      ]
    },
    "settings": {
      "label": "LicoArc client settings store",
      "category": "settings",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data"
      ]
    },
    "desktop-app": {
      "label": "Flutter future desktop frontend",
      "category": "core",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "flutter-app"
    },
    "multi-agent-routing": {
      "label": "Multi-agent routing and context distillation",
      "category": "routing",
      "enabled": true,
      "required": false,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "target-adapters",
        "portable-data"
      ],
      "runtimeToggle": true,
      "stateDirectories": [
        "lico-client/routing"
      ],
      "settingsKeys": [
        "routing.enabled",
        "routing.policyPath"
      ]
    },
    "native-sidecar": {
      "label": "Rust LicoArc client CLI sidecar",
      "category": "core",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "sidecar-binary",
      "cargoBin": "lico-client"
    }
  },
  "deferredCapabilities": {}
}
