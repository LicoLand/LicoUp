{
  "schemaVersion": "v0.0.1:client-desktop:packaging-modules-1",
  "description": "LicoUp desktop client packaging. Modules are organized by runtime function.",
  "packageProfile": "licoup",
  "bundle": {
    "moduleResourceDirectory": "modules",
    "manifestPath": "package-metadata/licoup/packaging-modules.json"
  },
  "modules": {
    "portable-data": {
      "label": "LicoUp client local settings, agent discovery cache, encrypted pairing state, skills, usage, activity, and conversation snapshots",
      "category": "storage",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "portable-data",
      "portableDirectories": [
        "licoup",
        "licoup/settings",
        "licoup/targets",
        "licoup/pairings",
        "licoup/skills",
        "licoup/pins",
        "licoup/activity",
        "licoup/snapshots"
      ]
    },
    "target-adapters": {
      "label": "Target adapters for Antigravity, Claude Code, Codex, Cursor, DeepSeek Harness, GitHub Copilot, Hermes Agent, Kilo Code, Kimi Code, Lico Agent, OpenClaw, OpenCode, and Pi Agent",
      "category": "agents",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "portable-data"
      ],
      "targetAdapters": [
        "openclaw",
        "claude-code",
        "codex",
        "antigravity",
        "opencode",
        "copilot",
        "kilo-code",
        "cursor",
        "deepseek-harness",
        "hermes",
        "kimi-code",
        "pi",
        "lico-agent"
      ]
    },
    "local-task-queue": {
      "label": "Bounded Rust FIFO queue for lightweight local client work",
      "category": "runtime",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar"
      ]
    },
    "protocol-adapters": {
      "label": "Service-neutral ACP conversation and MCP request/response adapters",
      "category": "protocols",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "target-adapters"
      ]
    },
    "skill-hub": {
      "label": "Passive Skill Hub boundary",
      "category": "skill-hub",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "portable-data"
      ]
    },
    "activity-snapshots": {
      "label": "Activity log and independent snapshot store",
      "category": "activity",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data"
      ]
    },
    "settings": {
      "label": "LicoUp client settings store",
      "category": "settings",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data"
      ]
    },
    "desktop-app": {
      "label": "Flutter future desktop frontend",
      "category": "core",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "flutter-app"
    },
    "native-sidecar": {
      "label": "Rust LicoUp client binary: CLI, gateway service, Lico Agent runtime and migration tool",
      "category": "core",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "sidecar-binary",
      "cargoBin": "licoup"
    },
    "lico-agent-sidecar": {
      "label": "LicoUp first-party Agent runtime (Gateway + Plan profile)",
      "category": "agents",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar"
      ]
    },
    "gateway-sidecar": {
      "label": "LicoUp Private Gateway Runtime (LLM Gateway)",
      "category": "agents",
      "enabled": true,
      "required": false,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar"
      ]
    },
    "subagents-mcp": {
      "label": "Independent LicoUp MCP connector and service, delivered by the org.licoland.feature.mcp package",
      "category": "agents",
      "enabled": false,
      "required": false,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "target-adapters",
        "skill-hub"
      ]
    },
    "telegram-channel": {
      "label": "Telegram communication channel, delivered by the org.licoland.channel.telegram package",
      "category": "agents",
      "enabled": false,
      "required": false,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "extension-packages"
      ]
    },
    "extension-packages": {
      "label": "Independently released first-party packages read through a signed package index",
      "category": "packages",
      "enabled": true,
      "required": false,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "native-sidecar",
        "portable-data"
      ]
    }
  },
  "deferredCapabilities": {}
}
