<?xml version="1.0" encoding="utf-8"?>
<AppInstaller xmlns="http://schemas.microsoft.com/appx/appinstaller/2018"
  Version="${LICOUP_MSIX_VERSION}"
  Uri="${LICOUP_APPINSTALLER_URI}">
  <MainPackage Name="land.lico.licoup"
    Publisher="${LICOUP_MSIX_PUBLISHER}"
    Version="${LICOUP_MSIX_VERSION}"
    ProcessorArchitecture="${LICOUP_MSIX_ARCH}"
    Uri="${LICOUP_MSIX_URI}" />
  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="12" ShowPrompt="true" UpdateBlocksActivation="false" />
    <AutomaticBackgroundTask />
  </UpdateSettings>
</AppInstaller>
