{
  "schemaVersion": 2,
  "id": "distill-policy",
  "label": "Distillation Test Policy",
  "agents": [
    {
      "id": "claude-code",
      "roles": ["architecture"],
      "capabilities": ["reasoning-deep"],
      "priority": 1
    },
    {
      "id": "codex",
      "roles": ["implementation"],
      "capabilities": ["tool-use"],
      "priority": 2
    },
    {
      "id": "fake-distiller",
      "roles": ["distillation"],
      "capabilities": ["summarize"],
      "priority": 3
    }
  ],
  "routing": {
    "strategy": "priority-fallback",
    "matchMode": "role-first"
  },
  "distillation": {
    "defaultDistiller": "fake-distiller",
    "alternateDistiller": "claude-code",
    "fidelityContract": {
      "requiredSections": [
        "objective",
        "currentState",
        "decisions",
        "constraints",
        "openItems"
      ],
      "maxPackageLength": 8192,
      "retryOnFailure": true,
      "maxRetries": 1
    }
  }
}
