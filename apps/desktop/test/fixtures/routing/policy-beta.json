{
  "schemaVersion": 2,
  "id": "policy-beta",
  "label": "Policy Beta",
  "agents": [
    {
      "id": "codex",
      "roles": ["implementation"],
      "capabilities": ["tool-use"],
      "priority": 1
    },
    {
      "id": "claude-code",
      "roles": ["architecture"],
      "capabilities": ["reasoning-deep"],
      "priority": 2
    }
  ],
  "routing": {
    "strategy": "priority-fallback",
    "matchMode": "role-first"
  },
  "distillation": {
    "defaultDistiller": "codex",
    "alternateDistiller": "claude-code"
  }
}
