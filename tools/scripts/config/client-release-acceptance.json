{
  "schemaVersion": "licomesh.client-release-acceptance-config.v3",
  "reportSchemaVersion": "licomesh.client-release-acceptance-report.v4",
  "producerPolicy": "same-process-required",
  "releaseTargetAuthority": {
    "schemaVersion": "licomesh.client-release-target-authority.v1",
    "selectedTargetIds": [
      "macos-direct-arm64",
      "android-direct-arm64-v8a"
    ]
  },
  "maxClockSkewMs": 5000,
  "sourceRoots": [
    "Cargo.toml",
    "Cargo.lock",
    "package.json",
    "package-lock.json",
    "crates/licoup-native",
    "apps/desktop",
    "packages/protocols",
    "tools"
  ],
  "reportOrder": [
    "pairwise",
    "stationAcceptance",
    "file",
    "trust",
    "acp",
    "acpArchive",
    "androidPlatformCrypto",
    "macosCli",
    "redaction"
  ],
  "artifactReceipt": {
    "ref": "build/reports/client-artifact-verification-receipts.json",
    "schemaVersion": "licomesh.client-artifact-verification-receipts.v3",
    "producer": "tools/scripts/client-artifact-verification-receipts.mjs"
  },
  "reports": {
    "pairwise": {
      "ref": "build/reports/secure-mesh-pairwise-content-crypto-audit.json",
      "schemaVersion": "licomesh.secure-mesh.pairwise-content-audit-report.v1",
      "producer": "tools/scripts/client-secure-mesh-pairwise-content-audit.mjs",
      "redactionRefs": [
        "build/reports/secure-mesh-pairwise-content-vector-corpus.json",
        "build/reports/secure-mesh-pairwise-content-review-signoff.json"
      ]
    },
    "stationAcceptance": { "ref": "build/reports/licoarc-badtower-acceptance.json", "schemaVersion": "licoup.licoarc-badtower.acceptance.v1", "producer": "tools/scripts/client-licoarc-badtower-acceptance.mjs" },
    "file": { "ref": "build/reports/secure-mesh-encrypted-file-handoff.json", "schemaVersion": "licomesh.secure-mesh.encrypted-file-handoff-report.v1", "producer": "tools/scripts/client-secure-mesh-encrypted-file-handoff.mjs" },
    "trust": { "ref": "build/reports/secure-mesh-trust-ux.json", "schemaVersion": "licomesh.secure-mesh.trust-ux-report.v2", "producer": "tools/scripts/client-secure-mesh-trust-ux.mjs" },
    "acp": { "ref": "build/reports/secure-mesh-acp-relay-governed-baseline.json", "schemaVersion": "licomesh.secure-mesh.acp-relay-governed-baseline-report.v1", "producer": "tools/scripts/client-secure-mesh-acp-relay-governed-baseline.mjs" },
    "acpArchive": { "ref": "build/reports/secure-mesh-acp-archive-release-proof.json", "schemaVersion": "licomesh.secure-mesh.acp-archive-release-proof-report.v1", "producer": "tools/scripts/client-secure-mesh-acp-archive-release-proof.mjs" },
    "androidPlatformCrypto": {
      "ref": "build/reports/secure-mesh-android-platform-crypto-acceptance.json",
      "schemaVersion": "licomesh.secure-mesh.android-platform-crypto-acceptance.v1",
      "producer": "tools/scripts/client-android-native-tests.mjs",
      "targetIds": ["android-direct-arm64-v8a"],
      "timeoutMs": 600000
    },
    "macosCli": {
      "ref": "build/reports/secure-mesh-release-cli-proof-macos.json",
      "schemaVersion": "licomesh.secure-mesh.release-cli-proof-report.v1",
      "producer": "tools/scripts/client-secure-mesh-release-cli-proof.mjs",
      "targetIds": ["macos-direct-arm64"],
      "args": ["--cli", "/Applications/LicoUp.app/Contents/MacOS/licoup-cli", "--platform", "macos", "--report", "build/reports/secure-mesh-release-cli-proof-macos.json"],
      "timeoutMs": 180000
    },
    "redaction": { "ref": "build/reports/secure-mesh-report-redaction.json", "schemaVersion": "licomesh.secure-mesh.report-redaction-verifier.v1", "producer": "tools/scripts/client-secure-mesh-report-redaction-verify.mjs" }
  },
  "artifacts": {
    "macos-direct-arm64": {
      "artifactKind": "macos-distribution-archive",
      "ref": "build/apps/desktop/distribution/macos/LicoUp-macos-arm64.dmg",
      "distributionManifestRef": "build/apps/desktop/distribution/macos/manifest.json",
      "installArtifactRef": "build/apps/desktop/runnable/macos/release/LicoUp.app",
      "entitlementsRef": "build/apps/desktop/signing/macos/release/ProductionRelease.resolved.entitlements",
      "versionPolicy": "numeric-core",
      "requiredArchitecture": "arm64",
      "consumerVerificationPolicy": "provenance-or-verifiable-signature"
    },
    "android-direct-arm64-v8a": {
      "artifactKind": "android-apk",
      "ref": "build/apps/desktop/android/release/app-release.apk",
      "packageName": "land.lico.licoup",
      "requiredArchitecture": "arm64-v8a",
      "consumerVerificationPolicy": "provenance-or-verifiable-signature"
    }
  }
}
