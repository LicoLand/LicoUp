      "id": "client-update-release-channel",
      "runner": "node",
      "script": "tests/verify-client-update-release-channel.mjs",
      "args": []
    },
    "physicalEvidenceManifest": {
      "id": "client-secure-mesh-physical-evidence-manifest",
      "runner": "node",
      "script": "tools/scripts/client-secure-mesh-physical-evidence-manifest.mjs",
      "args": []
    },
    "reportRedaction": {
      "id": "client-secure-mesh-report-redaction",
      "runner": "node",
      "script": "tools/scripts/client-secure-mesh-report-redaction-verify.mjs",
      "args": [
        "--release-proof-inputs"
      ],
      "runIdEnv": "LICO_SECURE_MESH_REDACTION_RUN_ID"
    }
  },
  "freshnessWindows": {
    "updateReleaseSeconds": 86400,
    "physicalMatrixSeconds": 86400,
    "androidPhysicalInstallLaunchSeconds": 86400,
    "physicalEvidenceManifestSeconds": 86400
  },
