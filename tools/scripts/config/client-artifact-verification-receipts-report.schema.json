{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "licomesh.client-artifact-verification-receipts.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "generatedBy",
    "selectedTargetIds",
    "productVersion",
    "buildNumber",
    "sourceStateDigest",
    "closureChallengeDigest",
    "policyBindings",
    "ok",
    "githubReleaseReady",
    "nonBlockingDistributionGuidance",
    "receipts",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": "licomesh.client-artifact-verification-receipts.v3" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedBy": { "const": "tools/scripts/client-artifact-verification-receipts.mjs" },
    "selectedTargetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["macos-direct-arm64", "android-direct-arm64-v8a"] }
    },
    "productVersion": { "type": "string", "minLength": 1 },
    "buildNumber": { "type": "integer", "minimum": 1 },
    "sourceStateDigest": { "$ref": "#/$defs/digest" },
    "closureChallengeDigest": { "$ref": "#/$defs/digest" },
    "policyBindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/policyBinding" },
            { "type": "object", "properties": { "id": { "const": "receipt-config" }, "ref": { "const": "tools/scripts/config/client-artifact-verification-receipts.json" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/policyBinding" },
            { "type": "object", "properties": { "id": { "const": "client-version" }, "ref": { "const": "tools/client-version.json" } } }
          ]
        }
      ]
    },
    "ok": { "type": "boolean" },
    "githubReleaseReady": { "type": "boolean" },
    "nonBlockingDistributionGuidance": { "$ref": "#/$defs/nonBlockingDistributionGuidance" },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/receipt" }
    },
    "privacy": { "$ref": "#/$defs/privacy" }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": {
        "properties": {
          "receipts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ready": { "const": true },
                "blockers": { "type": "array", "maxItems": 0 }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "receipts": {
            "type": "array",
            "contains": { "type": "object", "properties": { "ready": { "const": false } }, "required": ["ready"] },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$))(?!.*\\x00)(?!.*\\x5c).+$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "productVersion",
        "buildNumber",
        "artifactKind",
        "artifactDigest",
        "artifactManifestDigest",
        "sourceStateDigest",
        "closureChallengeDigest",
        "invocationNonceDigest",
        "evidenceSchemaVersion",
        "evidenceProducer",
        "evidenceProducerSourceDigest",
        "evidenceReportDigest",
        "freshnessReady",
        "consumerIntegritySignatureKind",
        "consumerIntegritySignatureReady",
        "publicVerificationMaterialReady",
        "consumerVerificationReady",
        "platformSecurityReady",
        "installReady",
        "launchReady",
        "smokeReady",
        "runtimeExecutableDigest",
        "dependencies",
        "installReceiptReady",
        "provenanceReady",
        "ready",
        "blockers"
      ],
      "properties": {
        "targetId": { "enum": ["macos-direct-arm64", "android-direct-arm64-v8a"] },
        "productVersion": { "type": "string", "minLength": 1 },
        "buildNumber": { "type": "integer", "minimum": 1 },
        "artifactKind": { "enum": ["macos-distribution-archive", "android-apk"] },
        "artifactDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "const": "" }] },
        "artifactManifestDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "const": "" }] },
        "sourceStateDigest": { "$ref": "#/$defs/digest" },
        "closureChallengeDigest": { "$ref": "#/$defs/digest" },
        "invocationNonceDigest": { "$ref": "#/$defs/digest" },
        "evidenceSchemaVersion": { "type": ["string", "integer"] },
        "evidenceProducer": { "type": "string", "minLength": 1 },
        "evidenceProducerSourceDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "const": "" }] },
        "evidenceReportDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "const": "" }] },
        "freshnessReady": { "type": "boolean" },
        "consumerIntegritySignatureKind": { "enum": ["none", "platform-local-validation", "detached-validation"] },
        "consumerIntegritySignatureReady": { "type": "boolean" },
        "publicVerificationMaterialReady": { "type": "boolean" },
        "consumerVerificationReady": { "type": "boolean" },
        "platformSecurityReady": { "type": "boolean" },
        "installReady": { "type": "boolean" },
        "launchReady": { "type": "boolean" },
        "smokeReady": { "type": "boolean" },
        "runtimeExecutableDigest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/dependency" }
        },
        "installReceiptReady": { "type": "boolean" },
        "provenanceReady": { "type": "boolean" },
        "ready": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "targetId": { "const": "macos-direct-arm64" },
              "ready": { "const": true }
            },
            "required": ["targetId", "ready"]
          },
          "then": {
            "properties": {
              "artifactManifestDigest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        {
          "if": { "properties": { "ready": { "const": true } }, "required": ["ready"] },
          "then": {
            "properties": {
              "artifactDigest": { "$ref": "#/$defs/digest" },
              "evidenceProducerSourceDigest": { "$ref": "#/$defs/digest" },
              "evidenceReportDigest": { "$ref": "#/$defs/digest" },
              "runtimeExecutableDigest": { "$ref": "#/$defs/digest" },
              "freshnessReady": { "const": true },
              "consumerVerificationReady": { "const": true },
              "platformSecurityReady": { "const": true },
              "installReady": { "const": true },
              "launchReady": { "const": true },
              "smokeReady": { "const": true },
              "installReceiptReady": { "const": true },
              "provenanceReady": { "const": true },
              "blockers": { "type": "array", "maxItems": 0 }
            }
          },
          "else": {
            "properties": { "blockers": { "type": "array", "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "targetId": { "const": "macos-direct-arm64" }, "ready": { "const": true } },
            "required": ["targetId", "ready"]
          },
          "then": {
            "properties": {
              "dependencies": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {
                    "allOf": [
                      { "$ref": "#/$defs/dependency" },
                      {
                        "type": "object",
                        "properties": {
                          "id": { "const": "macos-user-presence-proof" },
                          "ref": { "const": "build/reports/secure-mesh-macos-keychain-user-presence-proof.json" }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "pattern": "^build/(?!.*(?:^|/)[.][.](?:/|$))(?!.*\\x00)(?!.*\\x5c).+$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "nonBlockingDistributionGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking", "storeListingStatus", "platformSigningStatus", "notarizationStatus", "publicDownloadStatus", "updateChannelStatus", "rollbackChannelStatus"],
      "properties": {
        "blocking": { "const": false },
        "storeListingStatus": { "enum": ["not-configured", "planned", "ready"] },
        "platformSigningStatus": { "enum": ["not-configured", "planned", "ready"] },
        "notarizationStatus": { "enum": ["not-configured", "planned", "ready", "not-applicable"] },
        "publicDownloadStatus": { "enum": ["not-configured", "planned", "ready"] },
        "updateChannelStatus": { "enum": ["not-configured", "planned", "ready"] },
        "rollbackChannelStatus": { "enum": ["not-configured", "planned", "ready"] }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redacted",
        "absolutePathsIncluded",
        "runtimeIdentityIncluded",
        "deviceIdentifiersIncluded",
        "deviceModelsIncluded",
        "signingIdentitiesIncluded",
        "keyMaterialIncluded",
        "rawLogsIncluded"
      ],
      "properties": {
        "redacted": { "const": true },
        "absolutePathsIncluded": { "const": false },
        "runtimeIdentityIncluded": { "const": false },
        "deviceIdentifiersIncluded": { "const": false },
        "deviceModelsIncluded": { "const": false },
        "signingIdentitiesIncluded": { "const": false },
        "keyMaterialIncluded": { "const": false },
        "rawLogsIncluded": { "const": false }
      }
    }
  }
}
