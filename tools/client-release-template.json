{
  "schemaVersion": "licoup.client-release-template.v1",
  "versionAuthority": {
    "path": "tools/client-version.json"
  },
  "promotion": {
    "branches": ["nightly", "stable", "release"],
    "mergeMethod": "merge",
    "rulesetMutation": "forbidden",
    "linearHistory": false
  },
  "requiredPullRequestChecks": [
    "Branch flow",
    "Commit identity",
    "Client required",
    "Auditor"
  ],
  "pullRequestPreflight": {
    "command": "npm run client:pr:preflight -- --base origin/nightly --target <target> --full-target",
    "receiptSchema": "licoup.release-pre-pr-receipt.v1",
    "receiptPath": "build/reports/release-pre-pr-receipt.json",
    "remoteMutation": "forbidden",
    "prePushMode": "receipt-only"
  },
  "candidatePreflight": {
    "refPrefix": "release-candidate/",
    "targets": {
      "macos-arm64": ["source", "flutter", "rust", "dependencies", "release-policy"],
      "linux-glibc-arm64": ["source", "flutter", "rust", "dependencies", "release-policy"],
      "android-arm64": ["source", "flutter", "rust", "android", "dependencies", "release-policy"]
    }
  },
  "publication": {
    "workflow": ".github/workflows/client-release.yml",
    "ref": "release",
    "draftOnlyUntilVerified": true,
    "exactAssetSetRequired": true,
    "publishOnce": true,
    "remoteValidity": {
      "strategyGroup": "tools/client-remote-release-strategies.json",
      "activeStrategyIds": ["build-success"]
    }
  }
}
