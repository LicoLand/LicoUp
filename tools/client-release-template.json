{
  "schemaVersion": "licoup.client-release-template.v1",
  "entryCommands": {
    "nightly": "npm run client:release -- push nightly --version <version>",
    "stable": "npm run client:release -- push stable --version <version>",
    "release": "npm run client:release -- push release --version <version>",
    "publish": "npm run client:release -- publish --version <version> --target <target>"
  },
  "promotion": {
    "branches": ["nightly", "stable", "release"],
    "mergeMethod": "merge",
    "rulesetMutation": "forbidden"
  },
  "requiredPullRequestChecks": [
    "Branch flow policy",
    "Commit identity",
    "Client required"
  ],
  "publication": {
    "workflow": ".github/workflows/client-release.yml",
    "ref": "release",
    "jobTimeoutPolicy": "github-default",
    "operatorMonitoringTimeoutMinutes": null
  },
  "candidatePreflight": {
    "refPrefix": "release-candidate/",
    "commands": [
      { "command": "npm", "args": ["run", "client:gate:source"] },
      { "command": "npm", "args": ["run", "client:gate:flutter"] },
      { "command": "npm", "args": ["run", "client:gate:rust"] },
      { "command": "npm", "args": ["run", "client:gate:android"] },
      { "command": "npm", "args": ["run", "client:gate:dependencies"] },
      { "command": "npm", "args": ["run", "client:gate:release-policy"] }
    ]
  }
}
