{
  "schemaVersion": "licoup.client-release-template.v3",
  "versionAuthority": {
    "path": "tools/client-version.json"
  },
  "promotion": {
    "branches": ["nightly", "stable", "release"],
    "mergeMethod": "merge",
    "rulesetMutation": "forbidden",
    "linearHistory": false,
    "edges": [
      {
        "head": "action-prefixed",
        "base": "nightly",
        "requiredAggregate": "Client required"
      },
      {
        "head": "nightly",
        "base": "stable",
        "requiredAggregate": "Stable client"
      },
      {
        "head": "stable",
        "base": "release",
        "requiredAggregate": "Release ready"
      }
    ],
    "commonRequiredChecks": [
      "Branch flow",
      "Commit identity",
      "Auditor"
    ]
  },
  "publication": {
    "owner": "apple-release-service",
    "config": "tools/apple-release/macos-direct-arm64.json",
    "profiles": {
      "nightly": {
        "config": "tools/apple-release/macos-direct-arm64-nightly.json",
        "sourceBranch": "nightly",
        "releaseTrack": "nightly",
        "tag": "nightly",
        "mutablePrerelease": true
      },
      "stable": {
        "config": "tools/apple-release/macos-direct-arm64.json",
        "sourceBranch": "release",
        "releaseTrack": "stable",
        "tag": "v{version}",
        "mutablePrerelease": false
      }
    },
    "sourceBranch": "release",
    "repositoryMutation": "forbidden",
    "authorizationCount": 1,
    "interactiveAfterAuthorization": false,
    "assetRoles": [
      "installer",
      "installer-digest",
      "update-archive",
      "update-digest",
      "update-manifest"
    ],
    "exactDraftAssetSetRequired": true,
    "anonymousPublicInstallerDownloadRequired": true,
    "publicInstallerDigestRequired": true,
    "publicInstallAndStableLaunchRequired": true
  }
}
