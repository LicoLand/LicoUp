{
  "schema": "licoarc.client-support-matrix",
  "services": [
    { "id": "client-shell", "label": "Lico Arc client", "category": "core-client", "releaseBlocking": true },
    { "id": "rust-task-queue", "label": "Local Rust task queue", "category": "local-client-capability", "releaseBlocking": false },
    { "id": "acp-adapter", "label": "ACP adapter", "category": "local-client-capability", "releaseBlocking": false },
    { "id": "mcp-adapter", "label": "MCP adapter", "category": "local-client-capability", "releaseBlocking": false },
    { "id": "agent-discovery", "label": "Local agent discovery", "category": "desktop-client-capability", "releaseBlocking": false },
    { "id": "agent-conversations", "label": "Local agent conversations", "category": "desktop-client-capability", "releaseBlocking": false },
    { "id": "skill-management", "label": "Local skill management", "category": "desktop-client-capability", "releaseBlocking": false },
    { "id": "conversation-backup", "label": "Local conversation backup", "category": "desktop-client-capability", "releaseBlocking": false },
    { "id": "token-usage", "label": "Local token usage", "category": "desktop-client-capability", "releaseBlocking": false },
    { "id": "secure-mesh-pairwise", "label": "Secure Mesh client-to-client", "category": "core-client", "releaseBlocking": true },
    { "id": "mobile-relay", "label": "Mobile Relay", "category": "client-capability", "releaseBlocking": false },
    { "id": "optional-licolite-plugin", "label": "Optional LicoLite plugin", "category": "manual-integration", "releaseBlocking": false }
  ],
  "defaults": {
    "desktop": {
      "client-shell": "unverified",
      "rust-task-queue": "preview",
      "acp-adapter": "preview",
      "mcp-adapter": "preview",
      "agent-discovery": "preview",
      "agent-conversations": "preview",
      "skill-management": "preview",
      "conversation-backup": "preview",
      "token-usage": "preview",
      "secure-mesh-pairwise": "unverified",
      "mobile-relay": "unverified",
      "optional-licolite-plugin": "deferred"
    },
    "mobile": {
      "client-shell": "supported",
      "rust-task-queue": "preview",
      "acp-adapter": "preview",
      "mcp-adapter": "preview",
      "agent-discovery": "unsupported",
      "agent-conversations": "preview",
      "skill-management": "unsupported",
      "conversation-backup": "unsupported",
      "token-usage": "unsupported",
      "secure-mesh-pairwise": "preview",
      "mobile-relay": "preview",
      "optional-licolite-plugin": "deferred"
    }
  },
  "targets": [
    { "targetId": "windows-x64", "profile": "desktop", "overrides": { "client-shell": "preview", "secure-mesh-pairwise": "preview", "mobile-relay": "preview" } },
    { "targetId": "windows-arm64", "profile": "desktop" },
    { "targetId": "macos-x64", "profile": "desktop", "overrides": { "client-shell": "supported", "secure-mesh-pairwise": "preview", "mobile-relay": "preview" } },
    { "targetId": "macos-arm64", "profile": "desktop", "overrides": { "client-shell": "supported", "secure-mesh-pairwise": "preview", "mobile-relay": "preview" } },
    { "targetId": "linux-glibc-x64", "profile": "desktop", "overrides": { "client-shell": "preview", "secure-mesh-pairwise": "preview", "mobile-relay": "preview" } },
    { "targetId": "linux-glibc-arm64", "profile": "desktop", "overrides": { "client-shell": "preview", "secure-mesh-pairwise": "preview", "mobile-relay": "preview" } },
    { "targetId": "linux-musl-x64", "profile": "desktop", "overrides": { "client-shell": "preview", "secure-mesh-pairwise": "preview", "mobile-relay": "preview" } },
    { "targetId": "linux-musl-arm64", "profile": "desktop", "overrides": { "client-shell": "preview", "secure-mesh-pairwise": "preview", "mobile-relay": "preview" } },
    { "targetId": "android-arm64", "profile": "mobile" },
    { "targetId": "ios-simulator-arm64", "profile": "mobile" },
    {
      "targetId": "ios-arm64",
      "profile": "mobile",
      "overrides": {
        "client-shell": "unverified",
        "rust-task-queue": "unverified",
        "acp-adapter": "unverified",
        "mcp-adapter": "unverified",
        "agent-conversations": "unverified",
        "secure-mesh-pairwise": "unverified",
        "mobile-relay": "unverified"
      }
    }
  ]
}
