{
  "title": "StrategyBridge",
  "version": 1,
  "maxRequestBytes": 1048576,
  "maxPackageBytes": 8388608,
  "maxStates": 512,
  "maxTransitions": 2048,
  "maxParallelism": 8,
  "actions": [
    "strategy.package.prepare-import",
    "strategy.package.commit-import",
    "strategy.definition.list",
    "strategy.definition.inspect",
    "strategy.runtime.discover",
    "strategy.runtime.list",
    "strategy.binding.update",
    "strategy.binding.remove",
    "strategy.authorization.preview",
    "strategy.authorization.grant",
    "strategy.authorization.revoke",
    "strategy.run.start",
    "strategy.run.inspect",
    "strategy.run.resume",
    "strategy.run.cancel",
    "strategy.run.retry"
  ],
  "bindingKinds": ["actor", "runtime", "workspace"],
  "runtimeKinds": ["python", "node"],
  "stateKinds": [
    "pass",
    "choice",
    "fork",
    "join",
    "authorization",
    "actor",
    "script",
    "workset",
    "succeed",
    "fail",
    "blocked"
  ],
  "runStatuses": [
    "pending",
    "authorization-required",
    "runtime-missing",
    "running",
    "waiting",
    "retryable",
    "cancel-requested",
    "cancel-in-doubt",
    "blocked",
    "cancelled",
    "failed",
    "completed"
  ],
  "failureCodes": [
    "invalid_request",
    "package_unavailable",
    "package_too_large",
    "package_entry_invalid",
    "package_layout_invalid",
    "package_duplicate_entry",
    "package_resource_limit",
    "workflow_invalid",
    "definition_not_found",
    "preparation_not_found",
    "revision_conflict",
    "binding_incomplete",
    "authorization_required",
    "authorization_stale",
    "runtime_unavailable",
    "runtime_drifted",
    "sandbox_unavailable",
    "permit_denied",
    "run_not_found",
    "run_not_retryable",
    "callback_stale",
    "callback_conflict",
    "effect_in_doubt",
    "unsupported_action"
  ]
}
