{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoup.example/schemas/agent-orchestration-policy.schema.json",
  "title": "LicoUp Agent Orchestration Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "label", "commander", "modelLibrary", "agents", "workflow"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "$ref": "#/$defs/id128" },
    "label": { "type": "string", "maxLength": 256 },
    "commander": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/modelAssignment" }] },
    "modelLibrary": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/modelAssignment" } },
    "agents": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/agent" } },
    "workflow": { "$ref": "#/$defs/workflow" }
  },
  "$defs": {
    "id128": { "type": "string", "minLength": 1, "maxLength": 128 },
    "id256": { "type": "string", "minLength": 1, "maxLength": 256 },
    "reasoning": { "enum": [null, "low", "medium", "high", "max"] },
    "modelAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["agentId", "modelId", "reasoningLevel"],
      "properties": {
        "agentId": { "$ref": "#/$defs/id256" }, "modelId": { "$ref": "#/$defs/id256" },
        "reasoningLevel": { "$ref": "#/$defs/reasoning" }
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "roles", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/id256" },
        "roles": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id128" } },
        "capabilities": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id128" } }
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false, "required": ["steps"],
      "properties": { "steps": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/workflowStep" } } }
    },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["required"],
      "properties": { "required": { "type": "boolean" } }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceStepId", "pointer", "operator", "value"],
      "properties": {
        "sourceStepId": { "$ref": "#/$defs/id128" },
        "pointer": { "type": "string", "maxLength": 2048, "pattern": "^(?:/(?:[^~/]|~[01])*){0,64}$" },
        "operator": { "enum": ["exists", "equals", "contains"] },
        "value": { "if": { "type": "string" }, "then": { "type": "string", "maxLength": 4096 } }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false, "required": ["mode", "evidenceKinds"],
      "properties": {
        "mode": { "const": "requiredPass" },
        "evidenceKinds": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
      }
    },
    "workflowStep": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "predecessorId", "purpose", "roleId", "agentId", "modelId", "reasoningLevel", "contextStepIds", "maxContextBytes", "outputMode", "timeoutMs", "maxAttempts", "failureAction", "approval", "condition", "validation"],
      "properties": {
        "id": { "$ref": "#/$defs/id128" },
        "predecessorId": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id128" }] },
        "purpose": { "enum": ["action", "validation"] },
        "roleId": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id128" }] },
        "agentId": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id256" }] },
        "modelId": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id256" }] },
        "reasoningLevel": { "$ref": "#/$defs/reasoning" },
        "contextStepIds": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id128" } },
        "maxContextBytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "outputMode": { "enum": ["text", "json"] },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 16 },
        "failureAction": { "enum": ["stop", "continue"] },
        "approval": { "$ref": "#/$defs/approval" },
        "condition": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/condition" }] },
        "validation": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/validation" }] }
      }
    }
  }
}
