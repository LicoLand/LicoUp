{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.example/schemas/lico-arc-orchestrator-ipc.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/successReceipt" },
    { "$ref": "#/$defs/errorReceipt" }
  ],
  "$defs": {
    "boundedId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workflowId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "serviceStatusParams": { "type": "object", "additionalProperties": false, "properties": {} },
    "serviceStopParams": { "type": "object", "additionalProperties": false, "properties": {} },
    "policyRegisterParams": {
      "type": "object", "additionalProperties": false, "required": ["policy"],
      "properties": { "policy": { "type": "object" } }
    },
    "policyActivateParams": {
      "type": "object", "additionalProperties": false, "required": ["policyRevisionId"],
      "properties": { "policyRevisionId": { "$ref": "#/$defs/boundedId" } }
    },
    "workflowSubmitParams": {
      "type": "object", "additionalProperties": false,
      "required": ["policyRevisionId", "inputArtifactHandle", "inputDigest"],
      "properties": {
        "policyRevisionId": { "$ref": "#/$defs/boundedId" },
        "inputArtifactHandle": { "$ref": "#/$defs/boundedId" },
        "inputDigest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "workflowPreviewParams": {
      "type": "object", "additionalProperties": false,
      "required": ["policyRevisionId", "inputDigest"],
      "properties": {
        "policyRevisionId": { "$ref": "#/$defs/boundedId" },
        "inputDigest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "workflowStatusParams": {
      "type": "object", "additionalProperties": false, "required": ["workflowId"],
      "properties": { "workflowId": { "$ref": "#/$defs/workflowId" } }
    },
    "workflowCancelParams": {
      "type": "object", "additionalProperties": false, "required": ["workflowId"],
      "properties": { "workflowId": { "$ref": "#/$defs/workflowId" } }
    },
    "workflowApproveParams": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowId", "approvalId", "decision"],
      "properties": {
        "workflowId": { "$ref": "#/$defs/workflowId" },
        "approvalId": { "$ref": "#/$defs/boundedId" },
        "decision": { "type": "string", "enum": ["approved", "rejected"] }
      }
    },
    "workflowEventsParams": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowId", "afterCursor", "limit"],
      "properties": {
        "workflowId": { "$ref": "#/$defs/workflowId" },
        "afterCursor": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "workflowWaitParams": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowId", "afterCursor", "limit", "timeoutMs"],
      "properties": {
        "workflowId": { "$ref": "#/$defs/workflowId" },
        "afterCursor": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 },
        "timeoutMs": { "type": "integer", "minimum": 0, "maximum": 30000 }
      }
    },
    "workflowMessageParams": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowId", "messageArtifactHandle", "messageDigest"],
      "properties": {
        "workflowId": { "$ref": "#/$defs/workflowId" },
        "messageArtifactHandle": { "type": "string", "minLength": 1, "maxLength": 256 },
        "messageDigest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "clientKind", "method", "params"],
      "properties": {
        "protocolVersion": { "type": "string", "enum": ["lico.orchestrator.ipc.v1"] },
        "requestId": { "$ref": "#/$defs/boundedId" },
        "clientKind": { "type": "string", "enum": ["codex-mcp", "desktop", "cli"] },
        "method": { "type": "string", "enum": ["service.status", "service.stop", "policy.register", "policy.activate", "workflow.submit", "workflow.preview", "workflow.status", "workflow.cancel", "workflow.approve", "workflow.events", "workflow.wait", "workflow.message"] },
        "params": { "type": "object" },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "service.status" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/serviceStatusParams" } } } },
        { "if": { "properties": { "method": { "const": "service.stop" } } }, "then": { "required": ["idempotencyKey"], "properties": { "idempotencyKey": { "$ref": "#/$defs/boundedId" }, "params": { "$ref": "#/$defs/serviceStopParams" } } } },
        { "if": { "properties": { "method": { "const": "policy.register" } } }, "then": { "required": ["idempotencyKey"], "properties": { "idempotencyKey": { "$ref": "#/$defs/boundedId" }, "params": { "$ref": "#/$defs/policyRegisterParams" } } } },
        { "if": { "properties": { "method": { "const": "policy.activate" } } }, "then": { "required": ["idempotencyKey"], "properties": { "idempotencyKey": { "$ref": "#/$defs/boundedId" }, "params": { "$ref": "#/$defs/policyActivateParams" } } } },
        { "if": { "properties": { "method": { "const": "workflow.submit" } } }, "then": { "required": ["idempotencyKey"], "properties": { "idempotencyKey": { "$ref": "#/$defs/boundedId" }, "params": { "$ref": "#/$defs/workflowSubmitParams" } } } },
        { "if": { "properties": { "method": { "const": "workflow.preview" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/workflowPreviewParams" } } } },
        { "if": { "properties": { "method": { "const": "workflow.status" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/workflowStatusParams" } } } },
        { "if": { "properties": { "method": { "const": "workflow.cancel" } } }, "then": { "required": ["idempotencyKey"], "properties": { "idempotencyKey": { "$ref": "#/$defs/boundedId" }, "params": { "$ref": "#/$defs/workflowCancelParams" } } } },
        { "if": { "properties": { "method": { "const": "workflow.approve" } } }, "then": { "required": ["idempotencyKey"], "properties": { "idempotencyKey": { "$ref": "#/$defs/boundedId" }, "params": { "$ref": "#/$defs/workflowApproveParams" } } } },
        { "if": { "properties": { "method": { "const": "workflow.events" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/workflowEventsParams" } } } },
        { "if": { "properties": { "method": { "const": "workflow.wait" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/workflowWaitParams" } } } },
        { "if": { "properties": { "method": { "const": "workflow.message" } } }, "then": { "required": ["idempotencyKey"], "properties": { "idempotencyKey": { "$ref": "#/$defs/boundedId" }, "params": { "$ref": "#/$defs/workflowMessageParams" } } } }
      ]
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["cursor", "type", "state"],
      "properties": {
        "cursor": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["workflow.admitted", "approval.requested", "approval.approved", "condition.matched", "step.skipped", "dispatch.started", "dispatch.succeeded", "step.failed", "step.cancelled", "step.unknown", "workflow.completed", "workflow.failed", "workflow.cancelled", "workflow.unknown"] },
        "state": { "type": "string", "enum": ["admitted", "running", "awaiting_approval", "completed", "failed", "cancelled", "unknown"] }
      }
    },
    "bridgeDeliveryMode": {
      "type": "string",
      "enum": ["native_steer", "bridge_interrupt_resume", "bridge_follow_up"]
    },
    "liveEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["cursor", "type", "state"],
      "properties": {
        "cursor": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["child.dispatch.started", "child.output.progress", "child.output.completed", "child.turn.completed", "child.message.queued", "child.turn.interrupt.requested", "child.message.delivering", "child.message.delivered", "child.dispatch.completed", "workflow.state.changed"] },
        "state": { "type": "string", "enum": ["created", "admitted", "running", "idle", "awaiting_approval", "validating", "completed", "failed", "cancelled", "unknown"] },
        "stepId": { "$ref": "#/$defs/boundedId" },
        "agentId": { "$ref": "#/$defs/boundedId" },
        "deliveryMode": { "$ref": "#/$defs/bridgeDeliveryMode" },
        "outputBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "transportDiagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["transportClosed", "preHandlerRejected", "handlerMutations", "lastErrorCode"],
      "properties": {
        "transportClosed": { "type": "integer", "minimum": 0 },
        "preHandlerRejected": { "type": "integer", "minimum": 0 },
        "handlerMutations": { "type": "integer", "minimum": 0 },
        "lastErrorCode": { "type": ["string", "null"], "enum": [null, "peer_rejected", "protocol_mismatch", "invalid_request", "unknown_method", "frame_too_large", "frame_truncated", "rate_limited", "capacity_exceeded", "operation_forbidden", "capability_missing", "capability_rejected", "transport_closed", "service_already_running", "service_draining", "service_unavailable"] }
      }
    },
    "admissionDiagnostics": {
      "type": "object", "additionalProperties": false, "required": ["inFlightAdmissionIds"],
      "properties": { "inFlightAdmissionIds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/boundedId" } } }
    },
    "localBridgeStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "waitMode", "nativeFirst", "fallback", "maxConcurrentDispatches", "maxPendingMessagesPerWorkflow", "maxLiveEventsPerWorkflow", "maxWaitMs"],
      "properties": {
        "level": { "const": "bidirectional" },
        "waitMode": { "const": "wakeable" },
        "nativeFirst": { "const": true },
        "fallback": { "const": "interrupt_then_exact_session_resume" },
        "maxConcurrentDispatches": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxPendingMessagesPerWorkflow": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxLiveEventsPerWorkflow": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxWaitMs": { "type": "integer", "minimum": 1, "maximum": 30000 }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "state": { "type": "string", "enum": ["registered", "active", "created", "admitted", "running", "idle", "queued", "interrupting", "delivered", "stopped", "awaiting_approval", "validating", "completed", "failed", "cancelled", "unknown"] },
        "cursor": { "type": "integer", "minimum": 0 },
        "workflowId": { "$ref": "#/$defs/workflowId" },
        "policyRevisionId": { "$ref": "#/$defs/boundedId" },
        "adapterDecision": { "type": "string", "enum": ["acp", "native", "unavailable"] },
        "terminalReceipt": {
          "type": "object", "additionalProperties": false, "required": ["state", "digest"],
          "properties": {
            "state": { "type": "string", "enum": ["completed", "failed", "cancelled", "unknown"] },
            "digest": { "type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "approvalId": { "$ref": "#/$defs/boundedId" },
        "approvalState": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "serviceInstanceId": { "$ref": "#/$defs/boundedId" },
        "endpointGeneration": { "$ref": "#/$defs/boundedId" },
        "events": { "type": "array", "maxItems": 256, "items": { "oneOf": [{ "$ref": "#/$defs/event" }, { "$ref": "#/$defs/liveEvent" }] } },
        "nextCursor": { "type": "integer", "minimum": 0 },
        "hasMore": { "type": "boolean" },
        "active": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "timedOut": { "type": "boolean" },
        "cursorExpired": { "type": "boolean" },
        "messageId": { "$ref": "#/$defs/boundedId" },
        "deliveryMode": { "$ref": "#/$defs/bridgeDeliveryMode" },
        "transportDiagnostics": { "$ref": "#/$defs/transportDiagnostics" },
        "admissionDiagnostics": { "$ref": "#/$defs/admissionDiagnostics" },
        "localBridge": { "$ref": "#/$defs/localBridgeStatus" }
      }
    },
    "successReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "ok", "result"],
      "properties": {
        "protocolVersion": { "type": "string", "enum": ["lico.orchestrator.ipc.v1"] },
        "requestId": { "$ref": "#/$defs/boundedId" },
        "ok": { "const": true },
        "result": { "$ref": "#/$defs/result" }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": { "code": { "type": "string", "enum": ["peer_rejected", "protocol_mismatch", "invalid_request", "unknown_method", "frame_too_large", "frame_truncated", "rate_limited", "capacity_exceeded", "operation_forbidden", "capability_missing", "capability_rejected", "transport_closed", "service_already_running", "service_draining", "service_unavailable", "policy_schema_unsupported", "policy_schema_invalid", "policy_revision_unavailable", "policy_revision_inactive", "workflow_unavailable", "workflow_terminal", "workflow_not_active", "bridge_queue_full", "message_artifact_unavailable", "approval_rejected", "idempotency_conflict", "orchestrator_state_error"] } }
    },
    "errorReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "ok", "error"],
      "properties": {
        "protocolVersion": { "type": "string", "enum": ["lico.orchestrator.ipc.v1"] },
        "requestId": { "$ref": "#/$defs/boundedId" },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  }
}
