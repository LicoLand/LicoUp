{
  "machines": [
    {
      "id": "ansi-parser",
      "rust_module": "ansi_parser",
      "states": [
        { "id": "ground", "rust_name": "Ground" },
        { "id": "escape", "rust_name": "Escape" },
        { "id": "csi", "rust_name": "Csi" },
        { "id": "osc", "rust_name": "Osc" },
        { "id": "dcs", "rust_name": "Dcs" },
        { "id": "other", "rust_name": "Other" }
      ],
      "events": [
        "escape",
        "carriage-return",
        "text-byte",
        "csi-start",
        "osc-start",
        "dcs-start",
        "string-terminator",
        "intermediate",
        "single-escape",
        "sequence-final",
        "sequence-data",
        "bell",
        "finish"
      ],
      "initial": "ground",
      "terminal": [],
      "transitions": [
        { "from_state": "ground", "event": "escape", "to_state": "escape" },
        { "from_state": "ground", "event": "carriage-return", "to_state": "ground" },
        { "from_state": "ground", "event": "text-byte", "to_state": "ground" },
        { "from_state": "ground", "event": "finish", "to_state": "ground" },

        { "from_state": "escape", "event": "csi-start", "to_state": "csi" },
        { "from_state": "escape", "event": "osc-start", "to_state": "osc" },
        { "from_state": "escape", "event": "dcs-start", "to_state": "dcs" },
        { "from_state": "escape", "event": "string-terminator", "to_state": "ground" },
        { "from_state": "escape", "event": "intermediate", "to_state": "other" },
        { "from_state": "escape", "event": "single-escape", "to_state": "ground" },
        { "from_state": "escape", "event": "finish", "to_state": "ground" },

        { "from_state": "csi", "event": "sequence-final", "to_state": "ground" },
        { "from_state": "csi", "event": "sequence-data", "to_state": "csi" },
        { "from_state": "csi", "event": "finish", "to_state": "ground" },

        { "from_state": "osc", "event": "bell", "to_state": "ground" },
        { "from_state": "osc", "event": "escape", "to_state": "escape" },
        { "from_state": "osc", "event": "sequence-data", "to_state": "osc" },
        { "from_state": "osc", "event": "finish", "to_state": "ground" },

        { "from_state": "dcs", "event": "escape", "to_state": "escape" },
        { "from_state": "dcs", "event": "sequence-data", "to_state": "dcs" },
        { "from_state": "dcs", "event": "finish", "to_state": "ground" },

        { "from_state": "other", "event": "sequence-final", "to_state": "ground" },
        { "from_state": "other", "event": "sequence-data", "to_state": "other" },
        { "from_state": "other", "event": "finish", "to_state": "ground" }
      ]
    }
  ]
}
