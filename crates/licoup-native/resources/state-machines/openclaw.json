{
  "machines": [
    {
      "id": "agent.openclaw-protocol",
      "rust_module": "openclaw_protocol",
      "states": [
        { "id": "await-initialize", "rust_name": "AwaitInitialize" },
        { "id": "await-session", "rust_name": "AwaitSession" },
        { "id": "await-mode", "rust_name": "AwaitMode" },
        { "id": "await-prompt", "rust_name": "AwaitPrompt" },
        { "id": "finished", "rust_name": "Finished" }
      ],
      "events": ["initialized", "session-mode", "session-prompt", "mode-ready", "prompt-completed", "fail"],
      "initial": "await-initialize",
      "terminal": ["finished"],
      "transitions": [
        { "from_state": "await-initialize", "event": "initialized", "to_state": "await-session" },
        { "from_state": "await-session", "event": "session-mode", "to_state": "await-mode" },
        { "from_state": "await-session", "event": "session-prompt", "to_state": "await-prompt" },
        { "from_state": "await-mode", "event": "mode-ready", "to_state": "await-prompt" },
        { "from_state": "await-prompt", "event": "prompt-completed", "to_state": "finished" },
        { "from_state": "await-initialize", "event": "fail", "to_state": "finished" },
        { "from_state": "await-session", "event": "fail", "to_state": "finished" },
        { "from_state": "await-mode", "event": "fail", "to_state": "finished" },
        { "from_state": "await-prompt", "event": "fail", "to_state": "finished" },
        { "from_state": "finished", "event": "fail", "to_state": "finished" }
      ]
    }
  ]
}
