{
  "schema": "licoup.extension-package.v1",
  "id": "dev.example.agent.sdk-full",
  "version": "1.0.0",
  "displayName": "SDK sample: full Agent",
  "hostProtocol": {
    "major": 1,
    "minimumMinor": 0
  },
  "profiles": [
    {
      "id": "agent-execution",
      "major": 1,
      "capabilities": [
        "dev.example.agent/stream",
        "dev.example.agent/resume"
      ]
    },
    {
      "id": "usage-metric",
      "major": 1,
      "capabilities": [
        "dev.example.agent/usage"
      ]
    }
  ],
  "runtime": {
    "mode": "process",
    "entry": "agent.py",
    "runtimeRef": "user:python3"
  },
  "activation": "on-demand",
  "requires": [
    {
      "packageId": "org.licoland.core",
      "range": "^0.3"
    }
  ],
  "optionalRequires": [],
  "permissions": [],
  "contributions": [],
  "extensions": {
    "dev.example.agent/purpose": "SDK sample: a full Agent implements every optional agent-execution method it can honour, reports usage through C11, and answers honestly when it cannot."
  }
}
