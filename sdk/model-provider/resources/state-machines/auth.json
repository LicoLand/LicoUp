{
  "machines": [
    {
      "id": "model-provider.auth",
      "rust_module": "provider_auth",
      "states": [
        { "id": "new" },
        { "id": "awaiting-user", "rust_name": "AwaitingUser" },
        { "id": "pending" },
        { "id": "authorized" },
        { "id": "denied" },
        { "id": "revoked" }
      ],
      "events": [
        "observe-awaiting-user",
        "observe-pending",
        "observe-authorized",
        "observe-denied",
        "observe-revoked"
      ],
      "initial": "new",
      "terminal": ["denied", "revoked"],
      "transitions": [
        { "from_state": "new", "event": "observe-awaiting-user", "to_state": "awaiting-user" },
        { "from_state": "new", "event": "observe-pending", "to_state": "pending" },
        { "from_state": "new", "event": "observe-authorized", "to_state": "authorized" },
        { "from_state": "new", "event": "observe-denied", "to_state": "denied" },
        { "from_state": "new", "event": "observe-revoked", "to_state": "revoked" },
        { "from_state": "awaiting-user", "event": "observe-awaiting-user", "to_state": "awaiting-user" },
        { "from_state": "awaiting-user", "event": "observe-pending", "to_state": "pending" },
        { "from_state": "awaiting-user", "event": "observe-authorized", "to_state": "authorized" },
        { "from_state": "awaiting-user", "event": "observe-denied", "to_state": "denied" },
        { "from_state": "awaiting-user", "event": "observe-revoked", "to_state": "revoked" },
        { "from_state": "pending", "event": "observe-awaiting-user", "to_state": "awaiting-user" },
        { "from_state": "pending", "event": "observe-pending", "to_state": "pending" },
        { "from_state": "pending", "event": "observe-authorized", "to_state": "authorized" },
        { "from_state": "pending", "event": "observe-denied", "to_state": "denied" },
        { "from_state": "pending", "event": "observe-revoked", "to_state": "revoked" },
        { "from_state": "authorized", "event": "observe-awaiting-user", "to_state": "awaiting-user" },
        { "from_state": "authorized", "event": "observe-pending", "to_state": "pending" },
        { "from_state": "authorized", "event": "observe-authorized", "to_state": "authorized" },
        { "from_state": "authorized", "event": "observe-denied", "to_state": "denied" },
        { "from_state": "authorized", "event": "observe-revoked", "to_state": "revoked" }
      ]
    }
  ]
}
